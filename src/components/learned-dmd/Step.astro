---
// 図 3：陽解法の 1 ステップを行列 A で表す。左に A、右に u⁰ を A で何度も進めた分布
import { data, A, N, matVec, cells, diverging, pts, COLORS } from './fig';

const x0 = 36, y0 = 30, cell = 14.5;
const aCells = cells(A, x0, y0, cell, cell, (v) => diverging(v, 0.4));
const row = 7; // 8 行目
let u = data.traj1[0];
const profiles: { n: number; u: number[] }[] = [{ n: 0, u }];
for (let n = 1; n <= 20; n++) {
	u = matVec(A, u);
	if ([1, 5, 20].includes(n)) profiles.push({ n, u });
}
const px0 = 330, px1 = 690, py0 = 30, py1 = 230;
const sx = (x: number) => px0 + (px1 - px0) * x;
const sy = (v: number) => py1 - (py1 - py0) * v;
const shade = ['#8c99a6', '#5a7bd8', '#2350d8', '#15233d'];
---

<svg viewBox="0 0 720 268" role="img" aria-label="陽解法の 1 ステップを表す 16×16 の行列 A と、初期分布を A で進めた分布">
	<text x={x0} y="18" font-size="12" font-weight="600" fill={COLORS.text}>行列 A（uⁿ⁺¹ = A uⁿ）</text>
	<g>
		{aCells.map((c) => <rect x={c.x} y={c.y} width={c.w} height={c.h} fill={c.fill} />)}
		<rect x={x0} y={y0} width={N * cell} height={N * cell} fill="none" stroke={COLORS.rule} />
		<rect x={x0} y={y0 + row * cell} width={N * cell} height={cell} fill="none" stroke={COLORS.solver} stroke-width="1.5" />
	</g>
	<g font-size="10" fill={COLORS.muted}>
		<text x={x0 + N * cell + 6} y={y0 + row * cell + 11} fill={COLORS.solver}>8 行目：0.4, 0.2, 0.4</text>
		<text x={x0} y={y0 + N * cell + 14}>列 j（1〜16）</text>
	</g>
	<text x={px0} y="18" font-size="12" font-weight="600" fill={COLORS.text}>A を n 回掛けた分布</text>
	<g>
		<line x1={px0} x2={px1} y1={sy(0)} y2={sy(0)} stroke={COLORS.rule} />
		<line x1={px0} x2={px0} y1={py0} y2={py1} stroke={COLORS.rule} />
		{profiles.map((p, k) => <polyline points={pts(data.x, p.u, sx, sy)} fill="none" stroke={shade[k]} stroke-width="2" />)}
		<text x={px0 - 5} y={sy(0) + 4} font-size="10" fill={COLORS.muted} text-anchor="end">0</text>
		<text x={px0 - 5} y={sy(1) + 4} font-size="10" fill={COLORS.muted} text-anchor="end">1</text>
		<text x={px0} y={py1 + 16} font-size="10" fill={COLORS.muted} text-anchor="middle">0</text>
		<text x={px1} y={py1 + 16} font-size="10" fill={COLORS.muted} text-anchor="middle">1</text>
		<text x={(px0 + px1) / 2} y={py1 + 16} font-size="10" fill={COLORS.muted} text-anchor="middle">x</text>
		{profiles.map((p, k) => (
			<g font-size="11" fill={COLORS.text}>
				<line x1={px0 + 8 + k * 84} x2={px0 + 28 + k * 84} y1="252" y2="252" stroke={shade[k]} stroke-width="2" />
				<text x={px0 + 33 + k * 84} y="256">n = {p.n}</text>
			</g>
		))}
	</g>
</svg>
