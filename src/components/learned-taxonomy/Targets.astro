---
// 図 1：同じ拡散の問題を、① 時間発展の写像、② 解演算子、③ 解そのもの、の 3 通りに学習させて並べる
import { ui, type Lang } from './strings';

interface Props {
	lang?: Lang;
}
const { lang = 'ja' } = Astro.props;
const t = ui[lang];
const STEPS = 40;
---

<div class="lt-targets" data-t={JSON.stringify(t)}>
	<div class="lm-legend">
		<span style="--c: #15233d" class="dot">{t.reference}</span>
		<span style="--c: #2350d8">{t.stepMap}</span>
		<span style="--c: #16866a">{t.operator}</span>
		<span style="--c: #8a3fb0">{t.pinn}</span>
	</div>
	<svg data-top viewBox="0 0 720 230" role="img" aria-label={`${t.stepMap} / ${t.operator} / ${t.pinn}`}></svg>
	<div class="lm-scroll"><svg data-bot viewBox="0 240 720 230" role="img" aria-label={`${t.learnedW} / ${t.explicitA}`} style="min-width: 560px"></svg></div>
	<div class="lm-controls">
		<button type="button" class="lm-btn" data-play>{t.play}</button>
		<label>{t.time} t<input type="range" min="0" max={STEPS} step="1" value={STEPS} data-step /><output data-step-out></output></label>
		<span class="lm-readout" data-train></span>
	</div>
</div>

<style is:global>
	.lm-legend span.dot::before {
		width: 0.5rem;
		height: 0.5rem;
		border: none;
		border-radius: 50%;
		background: var(--c);
	}
</style>

<script>
	import * as C from './calc';
	import { el, text, clear, fmt, profileFrame, polyline, heatmap, COLORS } from './draw';

	const STEPS = 40;
	const PURPLE = '#8a3fb0';
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

	for (const root of document.querySelectorAll<HTMLElement>('.lt-targets')) {
		const t = JSON.parse(root.dataset.t!);
		const svg = root.querySelector('svg[data-top]')!;
		const svgBot = root.querySelector('svg[data-bot]')!;
		const slider = root.querySelector<HTMLInputElement>('[data-step]')!;
		const out = root.querySelector('[data-step-out]')!;
		const trainOut = root.querySelector('[data-train]')!;
		const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;

		const r = C.R_BASE, dt = C.dtOf(r);
		const ref = C.reference(r, C.TEST_U0, STEPS);
		const W = C.fitStep({ r });
		const roll = C.rollout(W, C.TEST_U0, STEPS);
		const G = C.fitOperators(r, STEPS);
		const { p: pinn, step: pinnStep } = C.pinnStart(STEPS * dt, C.TEST_FN);
		const A = C.explicitA(r);

		// 上段：3 つの分布
		const panels = [
			{ title: t.stepMap, color: COLORS.learned, x0: 40 },
			{ title: t.operator, color: COLORS.other, x0: 280 },
			{ title: t.pinn, color: PURPLE, x0: 520 },
		].map((p) => {
			const g = el('g', {}, svg);
			text(g, p.x0, 18, p.title, { fill: COLORS.text, size: 12, weight: 600 });
			const f = profileFrame(g, { x0: p.x0, x1: p.x0 + 170, y0: 34, y1: 164 });
			const line = el('polyline', { fill: 'none', stroke: p.color, 'stroke-width': 2 }, g);
			const dots = el('g', {}, g);
			const info = text(g, p.x0, 200, '', { size: 11, fill: COLORS.text });
			const info2 = text(g, p.x0, 216, '', { size: 11, fill: COLORS.text });
			return { ...p, ...f, g, line, dots, info, info2 };
		});
		// 幅が狭いときは 3 つの分布を縦に並べる
		const layout = () => {
			const narrow = root.clientWidth < 520;
			svg.setAttribute('viewBox', narrow ? '10 0 240 690' : '0 0 720 230');
			panels.forEach((p, i) => p.g.setAttribute('transform', narrow ? `translate(${40 - p.x0}, ${i * 230})` : ''));
		};
		layout();
		new ResizeObserver(layout).observe(root);

		// 下段：学習した W と陽解法の A（16×16）
		const gm = el('g', {}, svgBot);
		const cell = 11;
		const mats = [
			{ M: W, title: t.learnedW, x0: 40 },
			{ M: A, title: t.explicitA, x0: 280 },
		];
		for (const m of mats) {
			text(gm, m.x0, 262, m.title, { fill: COLORS.text, size: 12, weight: 600 });
			heatmap(gm, m.M, m.x0, 272, cell, 0.5);
			// 8 行目（i = 7）を枠で示し、帯の 3 つの値を書く
			el('rect', { x: m.x0, y: 272 + 7 * cell, width: 16 * cell, height: cell, fill: 'none', stroke: COLORS.text, 'stroke-width': 0.8, 'stroke-dasharray': '2 2' }, gm);
			const v = [m.M[7][6], m.M[7][7], m.M[7][8]].map((x) => x.toFixed(3)).join('  ');
			text(gm, m.x0, 272 + 16 * cell + 18, `${t.row}  ${v}`, { size: 11, fill: COLORS.text });
		}
		// 色の目盛り
		const cx = 520;
		text(gm, cx, 262, 'W, A', { fill: COLORS.text, size: 12, weight: 600 });
		for (let k = 0; k <= 20; k++) {
			const v = -1 + k / 10;
			const a = Math.abs(v); // 目盛りは −0.5〜0.5
			el('rect', { x: cx + k * 8, y: 276, width: 8, height: 12, fill: a < 0.004 ? '#fff' : v > 0 ? `rgba(35,80,216,${0.08 + 0.92 * a})` : `rgba(196,88,28,${0.08 + 0.92 * a})` }, gm);
		}
		el('rect', { x: cx, y: 276, width: 168, height: 12, fill: 'none', stroke: COLORS.rule }, gm);
		for (const [v, x] of [['−0.5', 0], ['0', 84], ['0.5', 168]] as const) text(gm, cx + x, 302, v, { anchor: 'middle', size: 10 });

		const pinnAt = (n: number) => C.XS.map((x) => C.pinnValue(pinn, x, n * dt));

		const draw = (n: number) => {
			const preds = [roll[n], C.mv(G[n], C.TEST_U0), pinnAt(n)];
			const evals = [n, 1, 1];
			panels.forEach((p, i) => {
				const xs = [0, ...C.XS, 1];
				const u = [0, ...preds[i], 0];
				p.line.setAttribute('points', polyline(xs.map((x, j) => [p.sx(x), p.sy(Math.max(-0.1, Math.min(1.1, u[j])))])));
				clear(p.dots);
				C.XS.forEach((x, j) => el('circle', { cx: p.sx(x), cy: p.sy(ref[n][j]), r: 2.6, fill: COLORS.text }, p.dots));
				p.info.textContent = `${t.evals} ${evals[i]}${t.times ? ' ' + t.times : ''}`;
				p.info2.textContent = `${t.errorRms} ${fmt(C.rmsDiff(preds[i], ref[n]))}`;
			});
			slider.value = String(n);
			out.textContent = `${n} Δt`;
		};

		let k = STEPS;
		draw(k);

		// PINN の学習を、画面を止めないよう少しずつ進める
		const train = () => {
			const t0 = performance.now();
			while (!pinn.done && performance.now() - t0 < 25) pinnStep();
			trainOut.innerHTML = `${t.pinn.replace(/^③ /, '')} ${t.training} <b>${pinn.iter} / ${C.PINN_ITERS}</b>`;
			draw(k);
			if (!pinn.done) setTimeout(train, 0);
		};
		const io0 = new IntersectionObserver((e) => {
			if (e.some((x) => x.isIntersecting)) {
				io0.disconnect();
				train();
			}
		});
		io0.observe(root);

		let raf = 0;
		const stop = () => {
			cancelAnimationFrame(raf);
			raf = 0;
			playBtn.textContent = t.play;
		};
		const play = () => {
			if (k >= STEPS) k = 0;
			playBtn.textContent = t.pause;
			let last = performance.now();
			const tick = (now: number) => {
				// 1 秒に 10 ステップ進める
				if (now - last >= 100) {
					k = Math.min(STEPS, k + 1);
					last = now;
					draw(k);
				}
				if (k < STEPS) raf = requestAnimationFrame(tick);
				else stop();
			};
			raf = requestAnimationFrame(tick);
		};
		playBtn.addEventListener('click', () => (raf ? stop() : play()));
		slider.addEventListener('input', () => {
			stop();
			k = +slider.value;
			draw(k);
		});
		if (reduce) playBtn.hidden = true;
	}
</script>
