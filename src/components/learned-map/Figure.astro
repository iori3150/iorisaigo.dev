---
// 図の枠と説明。番号と説明は MDX から渡す
interface Props {
	n: number;
	lang?: 'ja' | 'en';
}
const { n, lang = 'ja' } = Astro.props;
const id = `fig-${n}`;
const label = lang === 'ja' ? `図 ${n}` : `Figure ${n}`;
---

<figure class="lm-figure not-content" id={id}>
	<div class="lm-frame"><slot /></div>
	<figcaption><span class="lm-num">{label}</span><slot name="caption" /></figcaption>
</figure>

<style is:global>
	/* 図の共通の見た目。色は theme.css の A 案に合わせる */
	.lm-figure {
		--lm-text: #15233d;
		--lm-muted: #5c6b7c;
		--lm-faint: #8c99a6;
		--lm-rule: #d9e0e6;
		--lm-side: #ebeff2;
		--lm-accent: #2350d8;
		--lm-accent-bg: #dce4fa;
		/* 系列の色（dataviz の検証で 3 色とも合格） */
		--lm-s1: #2350d8;
		--lm-s2: #c4581c;
		--lm-s3: #16866a;
		margin: 1.75rem 0 2rem;
	}
	.lm-frame {
		border: 1px solid var(--lm-rule);
		background: #fff;
		padding: 1rem;
		border-radius: 4px;
	}
	.lm-figure figcaption {
		margin-top: 0.6rem;
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--lm-muted);
	}
	.lm-figure figcaption p {
		display: inline;
		margin: 0;
	}
	.lm-num {
		font-weight: 600;
		color: var(--lm-text);
		margin-right: 0.75em;
	}
	.lm-figure svg {
		display: block;
		width: 100%;
		height: auto;
		font-family: var(--sl-font);
		overflow: visible;
	}
	.lm-scroll {
		overflow-x: auto;
	}
	.lm-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.25rem;
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: var(--lm-text);
	}
	.lm-controls label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.lm-controls input[type='range'] {
		width: 10rem;
		accent-color: var(--lm-accent);
	}
	.lm-controls output,
	.lm-readout b {
		font-variant-numeric: tabular-nums;
		font-weight: 600;
	}
	.lm-readout {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		font-size: 0.875rem;
		color: var(--lm-muted);
		margin-top: 0.5rem;
	}
	.lm-btn {
		font: inherit;
		font-size: 0.8125rem;
		color: var(--lm-accent);
		background: transparent;
		border: 1px solid var(--lm-accent);
		border-radius: 4px;
		padding: 0.15rem 0.75rem;
		cursor: pointer;
		min-width: 4.5rem;
	}
	.lm-btn:focus-visible,
	.lm-figure [tabindex]:focus-visible {
		outline: 2px solid var(--lm-accent);
		outline-offset: 2px;
	}
	.lm-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		font-size: 0.8125rem;
		color: var(--lm-text);
		margin-bottom: 0.5rem;
	}
	.lm-legend span::before {
		content: '';
		display: inline-block;
		width: 1.25rem;
		height: 0;
		border-top: 2px solid var(--c);
		vertical-align: middle;
		margin-right: 0.4rem;
	}
	.lm-legend span.dash::before {
		border-top-style: dashed;
	}
</style>
