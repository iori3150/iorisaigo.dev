---
// 図 1：ソルバーの 1 ステップと学習モデルの 1 ステップを、時刻 t → t+Δt の写像として並べる
import { ui, stepBoxes, type Lang } from './strings';

interface Props {
	lang?: Lang;
}
const { lang = 'ja' } = Astro.props;
const t = ui[lang];
const boxes = stepBoxes[lang];

const W = 720;
const boxW = 160;
const boxH = 56;
const xs = [96, 280, 464];
const rows = [
	{ y: 100, label: t.solver, lines: boxes.solver, color: 'var(--lm-text)', fill: 'var(--lm-side)' },
	{ y: 214, label: t.learned, lines: boxes.learned, color: 'var(--lm-accent)', fill: 'var(--lm-accent-bg)' },
];
const nodeL = 14;
const nodeR = 648;
const nodeW = 58;
---

<svg viewBox={`0 0 ${W} 300`} role="img" aria-label={lang === 'ja' ? 'ソルバーと学習モデルの 1 ステップ' : 'One step of a solver and of a learned model'}>
	<defs>
		<marker id="lm-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
			<path d="M0 0 10 5 0 10z" fill="#5c6b7c"></path>
		</marker>
	</defs>
	{
		rows.map((r, ri) => (
			<g>
				<text x={xs[0]} y={r.y - boxH / 2 - 12} font-size="13" font-weight="600" fill={r.color}>
					{r.label}
				</text>
				<rect x={nodeL} y={r.y - 22} width={nodeW} height="44" rx="22" fill="#fff" stroke="#15233d" />
				<text x={nodeL + nodeW / 2} y={r.y + 5} font-size="15" text-anchor="middle" fill="#15233d" font-style="italic">
					u<tspan font-size="11" dy="-6">n</tspan>
				</text>
				<rect x={nodeR} y={r.y - 22} width={nodeW} height="44" rx="22" fill="#fff" stroke="#15233d" />
				<text x={nodeR + nodeW / 2} y={r.y + 5} font-size="15" text-anchor="middle" fill="#15233d" font-style="italic">
					u<tspan font-size="11" dy="-6">n+1</tspan>
				</text>
				{r.lines.map((lines, i) => (
					<g>
						<rect x={xs[i]} y={r.y - boxH / 2} width={boxW} height={boxH} rx="4" fill={r.fill} stroke={ri === 0 ? '#8c99a6' : '#2350d8'} />
						{lines.map((line, li) => (
							<text x={xs[i] + boxW / 2} y={r.y + 5 + (li - (lines.length - 1) / 2) * 18} font-size="12.5" text-anchor="middle" fill="#15233d">
								{line}
							</text>
						))}
					</g>
				))}
				<path d={`M${nodeL + nodeW} ${r.y}H${xs[0] - 3}`} stroke="#5c6b7c" marker-end="url(#lm-arrow)" />
				<path d={`M${xs[0] + boxW} ${r.y}H${xs[1] - 3}`} stroke="#5c6b7c" marker-end="url(#lm-arrow)" />
				<path d={`M${xs[1] + boxW} ${r.y}H${xs[2] - 3}`} stroke="#5c6b7c" marker-end="url(#lm-arrow)" />
				<path d={`M${xs[2] + boxW} ${r.y}H${nodeR - 3}`} stroke="#5c6b7c" marker-end="url(#lm-arrow)" />
			</g>
		))
	}
	<!-- 出力を次の入力に戻す -->
	<path d={`M${nodeR + nodeW / 2} 236V268H${nodeL + nodeW / 2}V239`} fill="none" stroke="#8c99a6" stroke-dasharray="4 4" marker-end="url(#lm-arrow)" />
	<text x={W / 2} y="290" font-size="12.5" text-anchor="middle" fill="#5c6b7c">{t.repeat}</text>
	<path d={`M${nodeR + nodeW / 2} 78V44H${nodeL + nodeW / 2}V75`} fill="none" stroke="#8c99a6" stroke-dasharray="4 4" marker-end="url(#lm-arrow)" />
</svg>
