---
// 図 3：2016〜2026 年の手法を帯に並べる。点を選ぶと、前の手法の何に困り何を変えたかを下に出す
import { ui, type Lang } from './strings';
import { bands, items } from './timeline-data';
import { numberOf, type CiteRef } from './refs';

interface Props {
	lang?: Lang;
	initial?: string;
}
const { lang = 'ja', initial = 'gns' } = Astro.props;
const t = ui[lang];

const W = 720;
const bandX = 124;
const preX = 162;
const yearX = (y: number) => (y <= 2015 ? preX : 216 + (y - 2016) * 46);
const bandH = 62;
const top = 8;
const itemY = (band: number, slot: number) => top + band * bandH + 15 + slot * 17;
const H = top + bands.length * bandH + 28;
const pos = Object.fromEntries(items.map((it) => [it.id, { x: yearX(it.year), y: itemY(it.band, it.slot) }]));
const edges = items.flatMap((it) => it.from.map((f) => ({ from: f.id, to: it.id })));
const curve = (a: { x: number; y: number }, b: { x: number; y: number }) => {
	const mx = (a.x + b.x) / 2;
	return `M${a.x} ${a.y}C${mx} ${a.y} ${mx} ${b.y} ${b.x} ${b.y}`;
};
const mark = (cs: CiteRef[]) => cs.map((c) => ({ k: c.k, n: numberOf(c.k), at: c.at }));
const detail = Object.fromEntries(
	items.map((it) => [
		it.id,
		{
			name: it.name,
			nameCites: mark([{ k: it.paper }]),
			problem: it.problem,
			problemCites: mark(it.problemCites),
			change: it.change,
			changeCites: mark(it.changeCites),
			// 線の根拠は、その手法の論文が先行として挙げている節
			from: it.from.map((f) => ({ id: f.id, cites: mark([{ k: it.paper, at: f.at }]) })),
		},
	]),
);
const labels = Object.fromEntries(items.map((it) => [it.id, it.label]));
// 右端に近い点はラベルを左に置く
const leftLabel = (it: (typeof items)[number]) => it.year >= 2026;
---

<div class="lm-timeline" data-initial={initial} data-detail={JSON.stringify(detail)} data-labels={JSON.stringify(labels)}>
	<div class="lm-scroll">
		<svg viewBox={`0 0 ${W} ${H}`} style="min-width: 600px" role="group" aria-label={lang === 'ja' ? '手法の年表' : 'Timeline of methods'}>
			{
				bands.map((b, i) => (
					<g>
						<rect x="0" y={top + i * bandH} width={W} height={bandH - 4} fill={i % 2 ? '#fff' : '#f3f5f6'} />
						<text x="8" y={top + i * bandH + bandH / 2 + 2} font-size="12" fill="#5c6b7c">
							{b}
						</text>
					</g>
				))
			}
			<line x1={preX + 30} x2={preX + 30} y1={top} y2={H - 24} stroke="#d9e0e6" stroke-dasharray="3 3" />
			<text x={preX} y={H - 8} font-size="11" fill="#5c6b7c" text-anchor="middle">{t.pre2016}</text>
			{
				[2016, 2018, 2020, 2022, 2024, 2026].map((y) => (
					<text x={yearX(y)} y={H - 8} font-size="11" fill="#5c6b7c" text-anchor="middle">
						{y}
					</text>
				))
			}
			<g data-edges>
				{edges.map((e) => <path d={curve(pos[e.from], pos[e.to])} fill="none" stroke="#c9d1d9" stroke-width="1.25" data-to={e.to} data-from={e.from} />)}
			</g>
			{
				items.map((it) => (
					<g class="lm-tl-item" tabindex="0" role="button" aria-pressed="false" data-id={it.id} aria-label={it.name}>
						<circle cx={pos[it.id].x} cy={pos[it.id].y} r="12" fill="transparent" />
						<circle class="dot" cx={pos[it.id].x} cy={pos[it.id].y} r="5.5" />
						<text
							x={pos[it.id].x + (leftLabel(it) ? -9 : 9)}
							y={pos[it.id].y + 4}
							font-size="11.5"
							text-anchor={leftLabel(it) ? 'end' : 'start'}
						>
							{it.year <= 2015 ? `${it.label} ${it.year}` : it.label}
						</text>
					</g>
				))
			}
		</svg>
	</div>
	<div class="lm-tl-panel" aria-live="polite">
		<p class="lm-tl-name"><span data-name></span><span data-name-cites></span></p>
		<dl>
			<dt data-problem-label>{t.problem}</dt>
			<dd data-problem></dd>
			<dt>{t.change}</dt>
			<dd data-change></dd>
			<dt data-from-label>{t.before}</dt>
			<dd data-from-list></dd>
		</dl>
	</div>
</div>

<style>
	.lm-tl-item {
		cursor: pointer;
		outline: none;
	}
	.lm-tl-item .dot {
		fill: #fff;
		stroke: #15233d;
		stroke-width: 1.5;
	}
	.lm-tl-item text {
		fill: #15233d;
		stroke: #fff;
		stroke-width: 3px;
		stroke-linejoin: round;
		paint-order: stroke;
	}
	.lm-tl-item:hover .dot {
		fill: #dce4fa;
	}
	.lm-tl-item:focus-visible .dot {
		stroke: #2350d8;
		stroke-width: 3;
	}
	.lm-tl-item[aria-pressed='true'] .dot {
		fill: #2350d8;
		stroke: #2350d8;
	}
	.lm-tl-item[aria-pressed='true'] text {
		fill: #2350d8;
		font-weight: 600;
	}
	.lm-tl-item.is-from .dot {
		stroke: #2350d8;
		stroke-width: 2.5;
	}
	.lm-tl-panel {
		margin-top: 0.75rem;
		padding-top: 0.75rem;
		border-top: 1px solid #d9e0e6;
		font-size: 0.9rem;
		line-height: 1.75;
		min-height: 11rem;
	}
	.lm-tl-name {
		font-weight: 600;
		margin: 0 0 0.25rem;
	}
	.lm-tl-panel dl {
		display: grid;
		grid-template-columns: 7.5em 1fr;
		gap: 0.2rem 0.75rem;
		margin: 0;
	}
	.lm-tl-panel dt {
		color: #5c6b7c;
		font-size: 0.8125rem;
		padding-top: 0.1rem;
	}
	.lm-tl-panel dd {
		margin: 0;
	}
	.lm-tl-panel dd :global(button) {
		font: inherit;
		color: #2350d8;
		background: none;
		border: 0;
		padding: 0;
		margin-right: 0.25em;
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.lm-tl-panel dd :global(span) {
		display: inline-block;
		margin-right: 1.25em;
	}
	@media (max-width: 30rem) {
		.lm-tl-panel dl {
			grid-template-columns: 1fr;
		}
		.lm-tl-panel dt {
			padding-top: 0.4rem;
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('.lm-timeline')) {
		const detail = JSON.parse(root.dataset.detail!);
		const labels = JSON.parse(root.dataset.labels!);
		const itemsEls = [...root.querySelectorAll<SVGGElement>('.lm-tl-item')];
		const edgeEls = [...root.querySelectorAll<SVGPathElement>('[data-edges] path')];
		const q = (s: string) => root.querySelector<HTMLElement>(s)!;

		const select = (id: string) => {
			const d = detail[id];
			for (const g of itemsEls) {
				g.setAttribute('aria-pressed', String(g.dataset.id === id));
				g.classList.toggle('is-from', d.from.some((f: { id: string }) => f.id === g.dataset.id));
			}
			for (const p of edgeEls) {
				const on = p.dataset.to === id;
				p.setAttribute('stroke', on ? '#2350d8' : '#c9d1d9');
				p.setAttribute('stroke-width', on ? '2' : '1.25');
				if (on) p.parentNode!.appendChild(p);
			}
			// 狭い幅で横に送っているとき、選んだ点が見える位置まで送る
			const sc = root.querySelector<HTMLElement>('.lm-scroll')!;
			const dot = root.querySelector<SVGGElement>(`.lm-tl-item[data-id="${id}"] .dot`)!;
			if (sc.scrollWidth > sc.clientWidth) {
				const r = dot.getBoundingClientRect();
				const sr = sc.getBoundingClientRect();
				sc.scrollLeft += r.left - sr.left - sc.clientWidth / 2;
			}
			const cites = (list: { k: string; n: number; at?: string }[]) =>
				list.map((c) => {
					const a = document.createElement('a');
					a.className = 'lm-cite';
					a.href = `#ref-${c.k}`;
					a.textContent = `[${c.n}${c.at ? ` ${c.at}` : ''}]`;
					return a;
				});
			q('[data-name]').textContent = d.name;
			q('[data-name-cites]').replaceChildren(...cites(d.nameCites));
			const problemEl = q('[data-problem]');
			problemEl.replaceChildren(d.problem, ...cites(d.problemCites));
			problemEl.hidden = q('[data-problem-label]').hidden = d.problem === '';
			q('[data-change]').replaceChildren(d.change, ...cites(d.changeCites));
			const fromEl = q('[data-from-list]');
			fromEl.replaceChildren(
				...d.from.map((f: { id: string; cites: { k: string; n: number; at?: string }[] }) => {
					const w = document.createElement('span');
					const b = document.createElement('button');
					b.type = 'button';
					b.textContent = labels[f.id];
					b.addEventListener('click', () => select(f.id));
					w.append(b, ...cites(f.cites));
					return w;
				}),
			);
			const hasFrom = d.from.length > 0;
			fromEl.hidden = !hasFrom;
			q('[data-from-label]').hidden = !hasFrom;
		};

		for (const g of itemsEls) {
			g.addEventListener('click', () => select(g.dataset.id!));
			g.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					select(g.dataset.id!);
				}
			});
		}
		select(new URLSearchParams(location.search).get('tl') ?? root.dataset.initial!);
	}
</script>
