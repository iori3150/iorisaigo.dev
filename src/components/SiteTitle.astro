---
import Default from '@astrojs/starlight/components/SiteTitle.astro';

// サイドバーが出る幅（50rem 以上）でだけ、サイドバーを隠すボタンを置く。
// 状態は <html data-sidebar-hidden> で表し、描画前の当てかたは astro.config.mjs の head にある
const { hasSidebar, lang } = Astro.locals.starlightRoute;
const label = lang === 'ja' ? 'ノートの一覧' : 'Note list';
---

{
	hasSidebar && (
		<button
			type="button"
			class="sidebar-toggle print:hidden"
			aria-label={label}
			title={label}
			aria-controls="starlight__sidebar"
			aria-expanded="true"
		>
			<svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
				<rect x="2.5" y="3.5" width="15" height="13" rx="2" stroke="currentColor" stroke-width="1.5" />
				<path d="M7.5 3.5v13" stroke="currentColor" stroke-width="1.5" />
				<path class="pane" d="M4 5h3.5v10H4z" fill="currentColor" />
			</svg>
		</button>
	)
}
<Default />

<script>
	const KEY = 'sidebar-hidden';
	const root = document.documentElement;
	const button = document.querySelector<HTMLButtonElement>('.sidebar-toggle');
	const sync = () => button?.setAttribute('aria-expanded', String(!root.hasAttribute('data-sidebar-hidden')));
	sync();

	// 本文と右の目次は幅を少しずつ変えずに（行を折り返し直さずに）滑らせる。
	// 動きの途中は開いた状態の幅で組み（theme.css）、測った位置の差を transform で埋める
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
	let moving: Animation[] = [];
	let turn = 0;

	button?.addEventListener('click', () => {
		const style = getComputedStyle(root);
		// CSS の圧縮で 240ms が .24s になるので、単位を見て ms にする
		const time = style.getPropertyValue('--sidebar-duration').trim();
		const duration = (parseFloat(time) || 0) * (time.endsWith('ms') ? 1 : 1000);
		const easing = style.getPropertyValue('--sidebar-easing').trim() || 'ease-out';
		const animate = !reduceMotion.matches && duration > 0;
		// 動かす要素と、位置を測る要素（本文は枠の中で中寄せされるので、枠でなく中身の左端を測る）
		const panes = [
			['.main-pane', '.main-pane .sl-container'],
			['.right-sidebar', '.right-sidebar'],
		].flatMap(([move, measure]) => {
			const el = document.querySelector<HTMLElement>(move);
			const ref = document.querySelector<HTMLElement>(measure);
			return el && ref ? [{ el, left: () => ref.getBoundingClientRect().left }] : [];
		});
		const from = animate ? panes.map((p) => p.left()) : [];

		moving.forEach((a) => a.cancel());
		moving = [];
		const current = ++turn;
		root.toggleAttribute('data-sidebar-animating', animate);
		const hidden = root.toggleAttribute('data-sidebar-hidden');

		if (animate) {
			root.setAttribute('data-sidebar-measuring', '');
			const to = panes.map((p) => p.left());
			root.removeAttribute('data-sidebar-measuring');
			moving = panes.map((p, i) => {
				const at = p.left();
				return p.el.animate(
					[{ transform: `translateX(${from[i] - at}px)` }, { transform: `translateX(${to[i] - at}px)` }],
					{ duration, easing, fill: 'forwards' },
				);
			});
			// サイドバー自体の遷移（theme.css）と同じ長さ。終わったら、同じコマで行き先の組みに戻して transform を外す
			const finished = moving.length
				? Promise.all(moving.map((a) => a.finished))
				: new Promise((r) => setTimeout(r, duration));
			finished.then(
				() => {
					if (current !== turn) return;
					root.removeAttribute('data-sidebar-animating');
					moving.forEach((a) => a.cancel());
					moving = [];
				},
				() => {},
			);
		}
		try {
			if (hidden) localStorage.setItem(KEY, '1');
			else localStorage.removeItem(KEY);
		} catch {}
		sync();
	});
</script>

<style>
	.sidebar-toggle {
		display: none;
	}
	@media (min-width: 50rem) {
		.sidebar-toggle {
			display: inline-flex;
			flex-shrink: 0;
			align-items: center;
			justify-content: center;
			width: 2.25rem;
			height: 2.25rem;
			margin-inline-end: 0.5rem;
			padding: 0;
			border: 0;
			border-radius: 0.375rem;
			background: transparent;
			color: var(--sl-color-accent);
			cursor: pointer;
		}
		.sidebar-toggle:hover {
			background-color: var(--sl-color-gray-6);
		}
		.sidebar-toggle:focus-visible {
			outline: 2px solid var(--sl-color-accent);
			outline-offset: 1px;
		}
		/* 状態は描画前に当たる <html data-sidebar-hidden> で見る（開いた直後に動かさない） */
		.pane {
			transform-box: fill-box;
			transform-origin: left center;
		}
		:global(:root[data-sidebar-hidden]) .sidebar-toggle {
			color: var(--sl-color-gray-3);
		}
		:global(:root[data-sidebar-hidden]) .sidebar-toggle:hover {
			color: var(--sl-color-white);
		}
		:global(:root[data-sidebar-hidden]) .pane {
			transform: scaleX(0);
			opacity: 0;
		}
	}
	@media (min-width: 50rem) and (prefers-reduced-motion: no-preference) {
		.sidebar-toggle {
			transition:
				color var(--sidebar-duration) var(--sidebar-easing),
				background-color 120ms;
		}
		.pane {
			transition:
				transform var(--sidebar-duration) var(--sidebar-easing),
				opacity var(--sidebar-duration) var(--sidebar-easing);
		}
	}
</style>
